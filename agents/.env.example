# Copy to agents/.env (gitignored) and fill in. Real environment variables win over this file.
# Auth uses DefaultAzureCredential (az login locally, managed identity when hosted) unless an API key is set.
# GitHub Models endpoints are rejected on purpose.

# --- Model: pick ONE provider (EMCEE_MODEL_PROVIDER=auto picks Foundry if both are set) ----------------------------
# EMCEE_MODEL_PROVIDER=auto            # auto | foundry | azure_openai

# Microsoft Foundry project (agent_framework_foundry.FoundryChatClient, Responses API)
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=gpt-4.1                # model DEPLOYMENT name in the project
# Aliases also accepted (azd ai agent conventions): AZURE_AI_PROJECT_ENDPOINT, AZURE_AI_MODEL_DEPLOYMENT_NAME

# Azure OpenAI resource (agent_framework_openai.OpenAIChatClient with azure_endpoint, Responses API)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1      # aliases: AZURE_OPENAI_MODEL, AZURE_OPENAI_CHAT_DEPLOYMENT_NAME
# AZURE_OPENAI_API_KEY=                # optional; leave empty to use DefaultAzureCredential (Entra ID)
# AZURE_OPENAI_API_VERSION=            # optional; the framework default is used when empty

# --- Model Mondays site --------------------------------------------------------------------------------------------
EMCEE_SITE_URL=http://localhost:8000   # the CLI's --site overrides this
# MM_WRITE_KEY=                        # only if the site sets MM_WRITE_KEY (sent as Authorization: Bearer)

# --- Behaviour -----------------------------------------------------------------------------------------------------
# EMCEE_MOCK=1                         # scripted agents, no LLM (same as --mock); handy for the hosted container
# EMCEE_MOCK_DELAY=0.4                 # mock only: fake "thinking" seconds per model call, for stage pacing
# EMCEE_LEARN_MCP=1                    # 0 disables the Microsoft Learn MCP server (https://learn.microsoft.com/api/mcp)
# EMCEE_MARP=auto                      # auto (marp on PATH) | npx (allow npx @marp-team/marp-cli) | off
# NO_COLOR=1                           # plain trace output
# EMCEE_ASCII=1                        # ASCII-only trace icons

# --- Telemetry (optional) ------------------------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# APPLICATIONINSIGHTS_CONNECTION_STRING=   # picked up by the hosted agent server
